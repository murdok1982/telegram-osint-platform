# =============================================
# Telegram OSINT/CTI Platform - Variables de Entorno
# =============================================
# COPIAR COMO .env Y RELLENAR TODOS LOS VALORES OBLIGATORIOS
# Los campos marcados con [OBLIGATORIO] DEBEN tener un valor unico y seguro

# --- Telegram API [OBLIGATORIO] ---
# Obtener en: https://my.telegram.org
TG_API_ID=
TG_API_HASH=

# --- OpenAI API [OBLIGATORIO] ---
OPENAI_API_KEY=sk-...

# --- Autenticacion API [OBLIGATORIO] ---
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
INTERNAL_API_KEY=

# --- Hash Salt para Pseudonimizacion [OBLIGATORIO] ---
# Generar con: python -c "import secrets; print(secrets.token_hex(16))"
HASH_SALT=

# --- Redis [OBLIGATORIO] ---
# Generar con: python -c "import secrets; print(secrets.token_hex(16))"
REDIS_PASSWORD=

# --- Base de Datos PostgreSQL ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=telegram_osint

# --- CORS (opcional, para frontend) ---
# Formato: URL1,URL2 (sin espacios)
CORS_ORIGINS=

# --- Filtro de Chats Monitoreados (OPCIONAL) ---
# Dejar vacio para monitorear TODOS los grupos/canales
# Formato: IDs separados por coma (ej: -1001234567890,-1009876543210)
MONITORED_CHATS=

# --- SMTP para Reportes por Email (OPCIONAL) ---
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_RECEIVER=

# --- Directorio de Reglas ---
RULES_DIR=/app/rules
